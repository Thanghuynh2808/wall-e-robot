<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">

    <!-- sim_mode:
           true  → dùng gz_ros2_control/GazeboSimSystem (Gazebo simulation)
           false → dùng wall_e_hardware/WallEHardware    (real robot)
    -->
    <xacro:arg name="sim_mode" default="false"/>

    <xacro:include filename="robot_core_v2.xacro" />
    <xacro:include filename="ros2_control.xacro" />
    <xacro:include filename="gazebo_control.xacro" />

</robot>
