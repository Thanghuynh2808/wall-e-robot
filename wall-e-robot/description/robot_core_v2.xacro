<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!--
        robot_core_v2.xacro
        Mô hình URDF robot thực tế dựa trên kích thước đo từ ảnh linh kiện:
          - Bánh xe (wheel.png):         radius=0.033m, width=0.026m
          - Tấm mica chữ nhật (chassis_mica.png): 200×120×3mm (Deck 1 & Deck 2)
          - Tấm mica tròn (circle_mica.png):      R=100mm, dày 3mm (Lidar Deck)
          - RPLidar (lidar.png):         H=55mm, body W=96.8mm (radius=0.048m)
          - Trụ đồng Deck1→Deck2: 40mm, Deck2→LidarDeck: 30mm

        Hệ tọa độ:
          - base_footprint : hình chiếu robot xuống mặt đất (z=0)
          - base_link       : tâm trục 2 bánh chủ động, cao 0.033m (= R_wheel) trên mặt đất
    -->

    <xacro:include filename="inertial_macros.xacro" />

    <!-- ======================== MATERIALS ======================== -->

    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>

    <material name="orange">
        <color rgba="0.87 0.53 0.13 1"/>
    </material>

    <material name="blue">
        <color rgba="0.2 0.2 1 1"/>
    </material>

    <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
    </material>

    <material name="red">
        <color rgba="1 0 0 1"/>
    </material>

    <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
    </material>

    <!-- ======================== DIMENSIONS (xacro properties) ======================== -->

    <!-- Bánh xe chính -->
    <xacro:property name="wheel_radius"  value="0.033" />
    <xacro:property name="wheel_length"  value="0.026" />
    <xacro:property name="wheel_mass"    value="0.050" />
    <!-- Khoảng cách từ tâm robot đến tâm bánh xe theo trục Y (track width/2) -->
    <!-- chassis rộng 180mm (0.18m) → mép ngoài 90mm, trục motor nhô ra ~15mm → tổng 0.105m -->
    <xacro:property name="wheel_y_offset" value="0.105" />

    <!-- Chassis (Thân robot chính hình hộp chữ nhật bo góc như hình mẫu: 250x180x85mm) -->
    <xacro:property name="mica_rect_x"       value="0.250" /> <!-- Chiều dài: 25cm -->
    <xacro:property name="mica_rect_y"       value="0.180" /> <!-- Chiều rộng: 18cm -->
    <xacro:property name="chassis_height"    value="0.085" /> <!-- Chiều cao: 8.5cm -->
    <xacro:property name="chassis_mass"      value="0.800" /> <!-- Khối lượng thân xe -->

    <!-- Bánh phụ con lăn (caster wheels) trước và sau -->
    <xacro:property name="caster_radius" value="0.015" />
    <xacro:property name="caster_mass"   value="0.030" />

    <!-- Vị trí trục bánh chủ động: nằm chính giữa chassis
         → 25cm / 2 = 12.5cm từ đuôi chassis
         → chassis_joint x = -0.125 (chassis link origin tại đuôi chassis) -->
    <xacro:property name="axle_from_rear" value="0.125" />

    <!-- RPLidar -->
    <xacro:property name="lidar_radius"  value="0.048" />
    <xacro:property name="lidar_height"  value="0.055" />
    <xacro:property name="lidar_mass"    value="0.170" />

    <!-- ======================== BASE FOOTPRINT ======================== -->
    <!--
        base_footprint: điểm ảo nằm trên mặt đất, hình chiếu của robot.
        Dùng làm gốc cho Nav2.
    -->
    <link name="base_footprint"/>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <!-- Nâng base_link lên bằng bán kính bánh xe so với mặt đất -->
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <!-- ======================== BASE LINK ======================== -->
    <!--
        base_link: tâm trục bánh chủ động.
        Link rỗng (không có visual/collision) — dùng làm điểm gốc tham chiếu.
    -->
    <link name="base_link"/>

    <!-- ======================== CHASSIS ======================== -->
    <!--
        Thân xe hình hộp chữ nhật màu trắng đại diện cho khuôn vỏ hộp 250x180x85mm.
        Link origin đặt tại GÓC SAU-TRÁI-DƯỚI của hộp (x=0 = đuôi chassis).
        Visual/collision/inertia center: (mica_rect_x/2, 0, chassis_height/2).
    -->
    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <!--
            x = -axle_from_rear: dịch về phía sau để trục bánh nằm ở chính giữa thân xe
            z = 0: đáy chassis ngang bằng tâm trục bánh (motor shaft ở tâm bánh)
        -->
        <origin xyz="${-axle_from_rear} 0 0" rpy="0 0 0"/>
    </joint>

    <link name="chassis">
        <visual>
            <origin xyz="${mica_rect_x/2} 0 ${chassis_height/2}" rpy="0 0 0"/>
            <geometry>
                <box size="${mica_rect_x} ${mica_rect_y} ${chassis_height}"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="${mica_rect_x/2} 0 ${chassis_height/2}" rpy="0 0 0"/>
            <geometry>
                <box size="${mica_rect_x} ${mica_rect_y} ${chassis_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${chassis_mass}"
                            x="${mica_rect_x}" y="${mica_rect_y}" z="${chassis_height}">
            <origin xyz="${mica_rect_x/2} 0 ${chassis_height/2}" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <!-- ======================== LEFT WHEEL ======================== -->
    <!--
        Bánh chủ động bên trái.
        Joint dạng continuous (xoay liên tục), trục quay = Z (sau khi rpy xoay -90°).
    -->
    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="0 ${wheel_y_offset} 0" rpy="${-pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
        <limit effort="1.0" velocity="10.0"/>
    </joint>

    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder length="${wheel_length}" radius="${wheel_radius}"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="${wheel_length}" radius="${wheel_radius}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${wheel_mass}"
                                 length="${wheel_length}"
                                 radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- ======================== RIGHT WHEEL ======================== -->
    <!--
        Bánh chủ động bên phải.
        rpy = (+pi/2, 0, 0): xoay ngược chiều để axis z quay đúng hướng tiến.
    -->
    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="0 ${-wheel_y_offset} 0" rpy="${pi/2} 0 0"/>
        <axis xyz="0 0 -1"/>
        <limit effort="1.0" velocity="10.0"/>
    </joint>

    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder length="${wheel_length}" radius="${wheel_radius}"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder length="${wheel_length}" radius="${wheel_radius}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${wheel_mass}"
                                 length="${wheel_length}"
                                 radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- ======================== CASTER WHEELS (FRONT & REAR) ======================== -->
    <!--
        Hai bánh phụ con lăn (ball caster) màu trắng đặt ở phía trước và sau.
        - Front caster: cách mép trước 20mm
        - Rear caster: cách mép sau 20mm
        - Vị trí Z: -(wheel_radius - caster_radius)
    -->
    
    <!-- ── Bánh phụ trước ── -->
    <joint name="front_caster_wheel_joint" type="fixed">
        <parent link="chassis"/>
        <child link="front_caster_wheel"/>
        <origin xyz="${mica_rect_x - 0.020} 0 ${-(wheel_radius - caster_radius)}"
                rpy="0 0 0"/>
    </joint>

    <link name="front_caster_wheel">
        <visual>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
        </collision>
        <xacro:inertial_sphere mass="${caster_mass}" radius="${caster_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_sphere>
    </link>

    <gazebo reference="front_caster_wheel">
        <mu1 value="0.0"/>
        <mu2 value="0.0"/>
        <material>Gazebo/White</material>
    </gazebo>

    <!-- ── Bánh phụ sau ── -->
    <joint name="rear_caster_wheel_joint" type="fixed">
        <parent link="chassis"/>
        <child link="rear_caster_wheel"/>
        <origin xyz="0.020 0 ${-(wheel_radius - caster_radius)}"
                rpy="0 0 0"/>
    </joint>

    <link name="rear_caster_wheel">
        <visual>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
        </collision>
        <xacro:inertial_sphere mass="${caster_mass}" radius="${caster_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_sphere>
    </link>

    <gazebo reference="rear_caster_wheel">
        <mu1 value="0.0"/>
        <mu2 value="0.0"/>
        <material>Gazebo/White</material>
    </gazebo>

    <!-- ======================== LASER FRAME (RPLidar) ======================== -->
    <!--
        Cảm biến LiDAR RPLidar A1 gắn lệch về phía sau (rear) trên nóc của chassis.
        - xyz: đặt cách đuôi xe 8cm (0.080m) trên trục X để lui xuống dưới một chút
        - z = chassis_height + lidar_height/2 = 0.085 + 0.0275 = 0.1125m
    -->
    <joint name="laser_joint" type="fixed">
        <parent link="chassis"/>
        <child link="laser_frame"/>
        <origin xyz="0.070 0 ${chassis_height + lidar_height/2}" rpy="0 0 3.14159"/>
    </joint>

    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
            </geometry>
            <material name="gray"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${lidar_mass}"
                                 length="${lidar_height}"
                                 radius="${lidar_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- Gazebo sensor plugin cho LiDAR (gpu_lidar 360°) -->
    <gazebo reference="laser_frame">
        <material>Gazebo/DarkGrey</material>
        <sensor name="laser" type="gpu_lidar">
            <always_on>1</always_on>
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.15</min>
                    <max>12.0</max>
                </range>
            </lidar>
            <topic>scan</topic>
            <gz_frame_id>laser_frame</gz_frame_id>
        </sensor>
    </gazebo>

</robot>
